# Required: Bearer token from https://entyrix.com (dashboard → API keys)
ENTYRIX_API_KEY=your-api-key-here

# Optional: override base URL (default: https://entyrix.com)
# Useful for staging or self-hosted Entyrix instances.
ENTYRIX_BASE_URL=https://entyrix.com

# Optional: HTTP timeout in milliseconds (default: 30000)
ENTYRIX_TIMEOUT_MS=30000
