{
  "name": "@entyrix/mcp",
  "version": "0.1.4",
  "description": "Model Context Protocol server for the Entyrix European business-registry (KYB) API. Exposes 10 stdio tools (search, lookup, details, network, relations, advanced search, compliance, financials, suppliers, rankings) for LLM clients (Claude Desktop, Claude Code, Cursor, ChatGPT).",
  "mcpName": "io.github.juliusgerman/entyrix-mcp",
  "type": "module",
  "bin": {
    "entyrix-mcp": "bin/entyrix-mcp.js"
  },
  "main": "dist/index.js",
  "homepage": "https://entyrix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliusgerman/entyrix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/juliusgerman/entyrix-mcp/issues"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "bash scripts/bundle.sh",
    "bump": "node scripts/bump-version.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "company-data",
    "kyb",
    "eu",
    "business-intelligence",
    "entyrix",
    "business-registry",
    "europe",
    "llm-tools"
  ],
  "author": "Entyrix <info@entyrix.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "undici": "^6.21.0",
    "vitest": "^4.1.10"
  }
}
