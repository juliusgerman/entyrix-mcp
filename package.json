{
  "name": "entyrix-mcp",
  "version": "0.0.1",
  "description": "Model Context Protocol server for the Entyrix European business-registry API. Exposes 8 stdio tools (search, lookup, details, advanced search, compliance, financials, suppliers, rankings) for LLM clients (Claude Desktop, Cursor, ChatGPT).",
  "type": "module",
  "bin": {
    "entyrix-mcp": "bin/entyrix-mcp.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "entyrix",
    "business-registry",
    "company-data",
    "europe",
    "llm-tools"
  ],
  "author": "Julius German <juliusgerman@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "undici": "^6.21.0",
    "vitest": "^2.1.8"
  }
}
