{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.juliusgerman/entyrix-mcp",
  "description": "KYB data from 23 European business registries — company briefs, financials, ownership, AML screening",
  "repository": {
    "url": "https://github.com/juliusgerman/entyrix-mcp",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@entyrix/mcp",
      "version": "0.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ENTYRIX_API_KEY",
          "description": "Bearer API key from https://entyrix.com (without it only discovery and public tools work)",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "ENTYRIX_BASE_URL",
          "description": "Override base URL (default https://entyrix.com)",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://entyrix.com/mcp/v1"
    }
  ]
}
